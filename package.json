{
  "name": "codex-micro-streamdeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Codex Micro controls and live Codex session status for Stream Deck MK.2.",
  "scripts": {
    "assets": "node scripts/generate-assets.mjs",
    "build": "npm run assets && npm run profile:generate && npm run typecheck && node scripts/build.mjs",
    "profile:generate": "node scripts/generate-profile.mjs",
    "profile:install": "node scripts/install-profile.mjs",
    "setup": "node scripts/install-keybindings.mjs",
    "smoke": "node scripts/run-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "streamdeck validate com.renehagen.codex-micro.sdPlugin --no-update-check",
    "pack": "npm run build && streamdeck pack com.renehagen.codex-micro.sdPlugin --output dist --no-update-check --force",
    "link": "streamdeck link com.renehagen.codex-micro.sdPlugin"
  },
  "dependencies": {
    "@elgato/streamdeck": "2.1.0"
  },
  "devDependencies": {
    "@elgato/cli": "1.7.4",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "sharp": "^0.34.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=24"
  }
}
